{
  "name": "@lornatang/dsh-frontgate",
  "version": "0.1.1",
  "description": "Password gate and reverse proxy for the DeepSeek Harness Web UI: scrypt login, signed session cookie, Host and Origin rewrite, launch-token exchange, WebSocket pass-through.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "password",
    "auth",
    "login",
    "reverse-proxy",
    "websocket",
    "self-hosted"
  ],
  "license": "Apache-2.0",
  "author": "Lornatang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lornatang/dsh-frontgate.git"
  },
  "homepage": "https://github.com/Lornatang/dsh-frontgate#readme",
  "bugs": {
    "url": "https://github.com/Lornatang/dsh-frontgate/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
